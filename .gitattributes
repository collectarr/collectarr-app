# Preserve canonical bytes used by pinned contract checksums on every platform.
/tool/core_contracts/*.json text eol=lf
/lib/core/api/generated/catalog_item_v1_fields.dart text eol=lf
# Import fixtures are parsed byte for byte; keep LF on Windows checkouts too.
/test/fixtures/** text=auto eol=lf
# Flutter regenerates this file with LF; CRLF conversion keeps it permanently modified on Windows.
/macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
# Kind registry and field-entry generators write LF; keep them LF on Windows too.
/lib/features/library/kinds/registry/collectarr_kind_database_tables.g.dart text eol=lf
/lib/dev/seeds/collectarr_dev_seed_registry.g.dart text eol=lf
/tool/architecture/generated/kind-field-entries.json text eol=lf
